{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3DemoBuckets",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:DeleteBucket", "s3:PutBucketTagging"],
      "Resource": "arn:aws:s3:::dana-test-*"
    },
    {
      "Sid": "SsmDemoParams",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:DeleteParameter", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:*:${account_id}:parameter/demo/*"
    },
    {
      "Sid": "OwnKeysAndConsole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey", "iam:DeleteAccessKey", "iam:ListAccessKeys",
        "iam:CreateLoginProfile", "iam:DeleteLoginProfile"
      ],
      "Resource": "arn:aws:iam::${account_id}:user/dana-test"
    },
    {
      "Sid": "TamperDemoOneRule",
      "Effect": "Allow",
      "Action": ["events:DisableRule", "events:EnableRule", "events:DescribeRule"],
      "Resource": "arn:aws:events:eu-west-1:${account_id}:rule/${fwd_rule}"
    }
  ]
}
