#!/bin/bash
set -euxo pipefail

dnf install -y python3-pip
pip3 install flask boto3

mkdir -p /opt/shop/templates /opt/shop/static
cat > /opt/shop/app.py <<'APP'
${app}
APP

cat > /opt/shop/templates/index.html <<'HTML'
${index_html}
HTML

cat > /opt/shop/static/style.css <<'CSS'
${style_css}
CSS

cat > /opt/shop/static/app.js <<'JS'
${app_js}
JS

cat > /etc/systemd/system/shop.service <<'UNIT'
[Unit]
Description=Demo shop website
After=network-online.target

[Service]
Environment=AWS_DEFAULT_REGION=${region}
Environment=PRODUCTS_TABLE=${products_table}
Environment=ORDERS_TABLE=${orders_table}
ExecStart=/usr/bin/python3 /opt/shop/app.py
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now shop
